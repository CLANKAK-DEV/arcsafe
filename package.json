{
  "name": "nox-safe",
  "version": "0.2.0",
  "description": "NoxSafe - independent N-of-M multi-signature custody built on Arc Network",
  "author": "SoftNox",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:testnet": "hardhat run scripts/deploy.js --network arcTestnet",
    "verify:factory": "hardhat run scripts/verify-factory.js --network arcTestnet",
    "verify:safe": "hardhat run scripts/verify-safe.js --network arcTestnet",
    "check:secrets": "node scripts/check-secrets.js",
    "size": "hardhat compile && hardhat size-contracts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^17.4.2",
    "hardhat": "^3.12.0"
  }
}
